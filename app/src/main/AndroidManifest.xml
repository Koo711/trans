<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 端末内AI (LiteRT-LM) が新しい Android を要求していても組み込めるようにする (使えない端末では案内を出す) -->
    <uses-sdk tools:overrideLibrary="com.google.ai.edge.litertlm" />

    <!-- OpenAI API・モデルのダウンロード -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 再生音声の取得 (AudioPlaybackCapture) とマイク入力の両方に必要 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 他のアプリの上に字幕を重ねて表示 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- 端末内AI（Gemma）を GPU で動かすためのライブラリ (無い端末では CPU で動かす) -->
        <uses-native-library
            android:name="libvndksupport.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".CaptionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />
    </application>
</manifest>
